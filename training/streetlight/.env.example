# --- Training env for the streetlight model ---

# Your Roboflow Private API Key: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# Your Roboflow workspace slug (find it in the URL of any project you own,
# e.g. https://app.roboflow.com/my-workspace/... -> "my-workspace")
ROBOFLOW_WORKSPACE=

# The project inside your workspace that holds the streetlight dataset.
# Create it once by forking https://universe.roboflow.com/pothole-fw8hn/street_light-0wrmn
# into your workspace, then paste its slug here.
ROBOFLOW_PROJECT=civiclens-streetlight

# Which dataset version to train on (each generated version bumps this integer).
ROBOFLOW_DATASET_VERSION=1

# Training hyperparameters (safe defaults for laptop / free Colab GPU)
EPOCHS=50
IMG_SIZE=640
BATCH_SIZE=16
MODEL_ARCH=yolov8n.pt   # nano — fastest. Swap for yolov8s.pt if you have a GPU.
