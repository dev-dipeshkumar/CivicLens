# --- Training env for the road-damage model ---

# Your Roboflow Private API Key: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# Your Roboflow workspace slug (see URL in app.roboflow.com)
ROBOFLOW_WORKSPACE=

# Project holding your forked road-damage dataset. Recommended source:
#   Fork -> https://universe.roboflow.com/defect-road-detection/road_defects-eif9i
#   (3,530 images, classes: alligator-crack, cracks, potholes, ruts)
# Then paste this project's slug here.
ROBOFLOW_PROJECT=civiclens-road-damage

# Which generated version to train on
ROBOFLOW_DATASET_VERSION=1

# Hyperparameters (safe defaults for laptop / free Colab GPU)
EPOCHS=60
IMG_SIZE=640
BATCH_SIZE=16
MODEL_ARCH=yolov8n.pt
