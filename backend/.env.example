# --- CivicLens AI backend config ---

# Origin allowed by CORS (exact match)
FRONTEND_ORIGIN=http://localhost:5173

# API key required by X-API-Key middleware on authority/analytics routes
API_KEY=civiclens-demo-key

# AI mode: "roboflow" | "local" | "mock"
# On error each mode falls back to the next in the chain: roboflow -> local -> mock
AI_MODE=mock

# --- Roboflow hosted inference (only needed if AI_MODE=roboflow) ---
# Get your key at https://app.roboflow.com/settings/api (free tier is plenty).
ROBOFLOW_API_KEY=

# Preferred: multiple public Roboflow Universe models, one per issue category.
# Format: "<category>:<slug/version>" comma separated. Each is called in
# parallel and the highest-confidence detection wins.
#
# Recommended models (each is a public Roboflow Universe model unless noted):
#   * pothole      — pothole-detection-yolov8/1        (public, single-class)
#   * garbage      — garbage_detection-wvzwv/9         (public, single-class)
#   * road_damage  — road_defects-eif9i/9              (public, 3.5k imgs, mAP ~0.8,
#                                                       returns cracks + potholes;
#                                                       backend normalizes classes)
#   * streetlight  — YOU fine-tune this one — no strong public model exists.
#                   See training/streetlight/README.md.
#                   After deploy, append: ,streetlight:<slug>/<version>
#
# Category is a HINT — for multi-class models (like road_defects) the actual
# raw class returned drives the category, so a "pothole" hit from the road_defects
# model still gets categorized as "pothole".
ROBOFLOW_MODELS=pothole:pothole-detection-yolov8/1,garbage:garbage_detection-wvzwv/9,road_damage:road_defects-eif9i/9

# Legacy single-model URL (used only if ROBOFLOW_MODELS is empty).
ROBOFLOW_MODEL_URL=

# Demo center — the seed script scatters reports around this point
DEMO_CENTER_LAT=26.9124
DEMO_CENTER_LNG=75.7873

# SQLite file path
DB_PATH=./civiclens.db
