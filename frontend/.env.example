# Frontend environment (Vite reads VITE_* at build time)

# Absolute origin of the FastAPI backend.
# Leave EMPTY in local dev — the Vite proxy in vite.config.ts handles /api and /uploads.
# In production (Netlify) set this to your deployed backend, e.g.:
#   VITE_API_BASE_URL=https://civiclens-api.onrender.com
VITE_API_BASE_URL=

# Value sent in the X-API-Key header on authority/analytics endpoints.
# MUST match backend's API_KEY. The demo default works out of the box locally.
VITE_API_KEY=civiclens-demo-key
